<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_background"
    android:paddingStart="8dp" android:paddingEnd="4dp" android:paddingTop="1dp" android:paddingBottom="1dp">
    <TextView android:id="@+id/empty_state" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:text="Codex Quota · Accounts verbinden" android:textColor="#BAC6D1" android:textSize="12sp"
        android:includeFontPadding="false" android:maxLines="2" />
    <LinearLayout android:id="@+id/account_rows" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" />
    <LinearLayout android:layout_width="28dp" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center">
        <TextView android:id="@+id/refresh" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:gravity="center" android:text="↻" android:textColor="#6ED8BA"
            android:textSize="24sp" android:includeFontPadding="false" android:contentDescription="Quota aktualisieren" />
        <TextView android:id="@+id/widget_more" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:textColor="#9EADBA" android:textSize="9sp" android:includeFontPadding="false"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
