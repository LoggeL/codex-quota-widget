<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:paddingTop="6dp" android:paddingBottom="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:includeFontPadding="false" android:id="@+id/account_name" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end"
            android:textColor="#F2F5F8" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:includeFontPadding="false" android:id="@+id/account_plan" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#6ED8BA" android:textSize="10sp" android:layout_marginStart="8dp" />
    </LinearLayout>
    <TextView android:includeFontPadding="false" android:id="@+id/account_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#9EADBA" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:id="@+id/window_rows" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
