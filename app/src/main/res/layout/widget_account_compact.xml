<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/compact_account" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="6dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/account_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="#F2F5F8" android:textSize="11sp" android:textStyle="bold" android:maxLines="1"
            android:ellipsize="end" android:includeFontPadding="false" />
        <TextView android:id="@+id/compact_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#F0BF76" android:textSize="9sp" android:includeFontPadding="false" android:layout_marginStart="3dp"
            android:text="alt" android:visibility="gone" />
    </LinearLayout>
    <TextView android:id="@+id/compact_error" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#F0BF76" android:textSize="10sp" android:includeFontPadding="false" android:maxLines="2"
        android:ellipsize="end" android:visibility="gone" />
    <LinearLayout android:id="@+id/window_rows" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
